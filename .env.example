# Copy this file to .env and replace every example value.
# Never commit the completed .env file.

ROUNDCUBE_DB_NAME=roundcube
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Secure IMAP, normally port 993.
IMAP_SERVER=ssl://mail.example.com
IMAP_PORT=993

# Authenticated SMTP submission with STARTTLS, normally port 587.
SMTP_SERVER=tls://mail.example.com
SMTP_PORT=587
